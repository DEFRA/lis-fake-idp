{
  "name": "@defra/fake-idp",
  "version": "0.0.1",
  "description": "Fakes upstream OIDC identity providers (DEFRA CI, Entra ID) for local and CDP dev environments",
  "main": "src/index.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "NODE_ENV=production vite build",
    "build:frontend:watch": "vite build --watch",
    "dev": "run-p build:frontend:watch server:watch",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json}\"",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "pretest": "npm run build:frontend",
    "pretest:coverage": "npm run build:frontend",
    "test": "TZ=UTC vitest run",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "server:watch": "nodemon --ext js,json --legacy-watch ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node --use-strict .",
    "prepare": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "security-audit": "audit-ci",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/hapi": "21.4.13",
    "@hapi/inert": "^7.1.3",
    "@hapi/vision": "7.0.3",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "govuk-frontend": "^6.6.0",
    "hapi-pino": "13.0.0",
    "nunjucks": "3.2.4",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@defra/lis-infra-eslint-config": "^0.12.3",
    "@vitest/coverage-v8": "^5.1.0",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "10.14.0",
    "husky": "^9.1.7",
    "jsdom": "31.0.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.108.0",
    "stylelint": "^17.14.0",
    "stylelint-config-gds": "^3.0.0",
    "vite": "^8.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tmp": "0.2.5"
  }
}
